<Project>

  <!--
    Shared settings for every project that is part of the Butterfly framework (src/, tests/, tools/).
    samples/ opts out on purpose: samples consume Butterfly the same way an external project would.
  -->

  <!-- Repository layout -->
  <PropertyGroup>
    <IsButterflyFrameworkProject>true</IsButterflyFrameworkProject>
    <ButterflyRoot>$(MSBuildThisFileDirectory)</ButterflyRoot>
    <ButterflyEngDirectory>$(ButterflyRoot)eng\</ButterflyEngDirectory>
    <ButterflySdkSourceDirectory>$(ButterflyRoot)src\Butterfly.Sdk\Sdk\</ButterflySdkSourceDirectory>
    <ButterflyPackageRoot>$(ButterflyRoot)Packages\Release\Butterfly\</ButterflyPackageRoot>
  </PropertyGroup>

  <!-- Version: defined once, inside Butterfly.Sdk, and shared by every project -->
  <Import Project="$(ButterflySdkSourceDirectory)Butterfly.Version.props" />

  <PropertyGroup>
    <Version>$(ButterflyVersion)</Version>
  </PropertyGroup>

  <!-- Compilation -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Strong naming -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(ButterflyEngDirectory)Butterfly.snk</AssemblyOriginatorKeyFile>
    <ButterflyPublicKey></ButterflyPublicKey>
  </PropertyGroup>

  <!-- Packaging: every packable project lands in the local Butterfly feed -->
  <PropertyGroup>
    <Authors>Antril Organization</Authors>
    <PackageProjectUrl>https://www.antril.org/Butterfly/</PackageProjectUrl>
    <PackageIcon>Butterfly.png</PackageIcon>
    <PackageOutputPath>$(ButterflyPackageRoot)</PackageOutputPath>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <!-- Re-packing the same version would otherwise leave a stale copy in the NuGet cache. -->
    <ButterflyEvictPackageCache Condition="'$(ButterflyEvictPackageCache)' == ''">true</ButterflyEvictPackageCache>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ButterflyEngDirectory)Butterfly.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
